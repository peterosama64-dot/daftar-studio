// PostgreSQL everywhere (local, preview, production).
// Enum-like fields are Strings; allowed values live in src/lib/constants.ts.
// Env names match the Supabase ↔ Vercel integration, which sets them automatically:
// POSTGRES_PRISMA_URL = pooled connection (app), POSTGRES_URL_NON_POOLING = direct (migrations).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id             String             @id @default(cuid())
  email          String             @unique
  name           String             @default("")
  passwordHash   String
  currency       String             @default("EGP")
  createdAt      DateTime           @default(now())
  tasks          Task[]
  entries        Entry[]
  gmail          GmailAccount?
  push           PushSubscription[]
  lastDigest     String? // "YYYY-MM-DD" of the last morning reminder, so the daily job never sends twice
  lastMonthly    String? // "YYYY-MM" of the last month-summary notification
  dayHours       Int                @default(6) // hours of work a day the week plan fills up to
  calendarToken  String?            @unique // private iCal feed link (Google / Apple Calendar subscribe to it)
  invoicePrefix  String             @default("INV")
  invoiceYear    Int? // the year invoiceSeq counts in; numbering restarts at 001 each year
  invoiceSeq     Int                @default(0) // last invoice number given in invoiceYear
  taxRate        Float? // default VAT % for new invoices
  taxNo          String             @default("") // tax registration number printed on invoices
  autoBackup     Boolean            @default(true) // keep a weekly copy of the notebook (AutoBackup)
  lastAutoBackup String? // "YYYY-MM-DD" of the last weekly copy
  autoBackups    AutoBackup[]
  clientInvoices ClientInvoice[]
  incomeGoal     Float? // monthly income target, shown on the home page
  suspendedAt    DateTime? // set by an admin: can't sign in, no reminders, shared links stop working
  lastSeenAt     DateTime? // updated at most hourly, for the admin's activity numbers
  quotes         Quote[]
  recurring      RecurringJob[]
  clientInfos    ClientInfo[]
  syncedOps      SyncedOp[]
  templates      TaskTemplate[]
  // Shown on invoices and quotes
  logoUrl        String?
  bizPhone       String             @default("")
  bizAddress     String             @default("")
  payInfo        String             @default("") // how to pay: InstaPay, wallet, bank account…
  fxRates        String             @default("{}") // JSON {"USD": 48.5}: 1 unit = this many of the main currency
  leads          Lead[]
  meetings       Meeting[]
  budgets        String             @default("{}") // JSON {"print": 500}: monthly spending limit per expense category
  weeklyEmail    Boolean            @default(false) // Friday summary by email
  lastWeekly     String? // "YYYY-MM-DD" of the last weekly email, so a week is never sent twice
  reviewsToken   String?            @unique // public page of chosen client reviews
}

model Task {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  client           String         @default("")
  due              DateTime?
  priority         String         @default("normal") // high | normal | low
  status           String         @default("todo") // todo | doing | done
  source           String         @default("manual") // manual | voice | gmail | chat
  notes            String         @default("")
  agreed           Float?
  paid             Float?
  doneAt           DateTime?
  timeSpent        Int            @default(0) // seconds tracked with the timer
  timerStart       DateTime? // set while the timer runs
  shareToken       String?        @unique // public invoice link
  recurringId      String? // made by a RecurringJob
  reviewToken      String?        @unique // public link where the client reviews the delivered files
  revisionsAllowed Int? // revisions included in the price; more are extra
  approvedAt       DateTime? // client approved the delivered work
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deliveries       Delivery[]
  revisions        Revision[]
  subtasks         Subtask[]
  installments     Installment[]
  currency         String? // null = the account's main currency
  contract         Contract?
  rating           Int? // 1–5 from the client, after approving the work
  ratingNote       String?
  ratedAt          DateTime?
  showcase         Boolean        @default(false) // the owner chose to show this review on the public reviews page
  planDay          DateTime? // the day of the week plan this job is placed on (local midnight)
  estimate         Int? // estimated minutes of work, for the week plan
  nudgedAt         DateTime? // last follow-up sent to the client about delivered work awaiting their reply
  invoiceNo        String? // sequential number (INV-2026-001), given once when the invoice is issued; never reused
  invoicedAt       DateTime? // issue date printed on the invoice
  discount         Float? // taken off the agreed price, in the task's currency
  taxRate          Float? // VAT % added after the discount (e.g. 14, 5, 15)
  items            Json? // invoice line items [{ desc, amount }]; when set, agreed is their sum
  groupInvoiceId   String? // billed on a combined invoice (ClientInvoice) instead of its own
  groupInvoice     ClientInvoice? @relation(fields: [groupInvoiceId], references: [id], onDelete: SetNull)

  @@unique([userId, invoiceNo])
  @@index([userId, status])
}

model Entry {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String // income | subscription | expense
  name         String
  client       String    @default("")
  amount       Float
  date         DateTime? // income + expense
  startMonth   String? // subscription: "YYYY-MM"
  endMonth     String? // subscription: last billed month, null = active
  createdAt    DateTime  @default(now())
  origAmount   Float? // when entered in another currency: the amount as typed (amount itself is always in the main currency)
  origCurrency String?
  category     String? // expense/subscription category key (lib/categories.ts); null = uncategorised

  @@index([userId, kind])
}

// One connected Gmail per user, read-only. The refresh token is encrypted (lib/crypto.ts);
// email content is never stored, only read when the user asks.
model GmailAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  refreshToken String
  createdAt    DateTime @default(now())
}

// A browser/phone that asked for reminder notifications (Web Push).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// App-wide values generated on first use (the Web Push key pair). Secret values are sealed (lib/crypto.ts).
model AppSetting {
  key   String @id
  value String
}

// A price quote sent to a client before the work starts. Accepting it creates a task.
model Quote {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       String    @default("")
  title        String
  items        Json // [{ desc: string, amount: number }]
  validDays    Int       @default(14)
  deliveryDays Int?
  notes        String    @default("")
  status       String    @default("draft") // draft | accepted
  taskId       String?
  shareToken   String?   @unique // public link the client opens (and can accept from)
  createdAt    DateTime  @default(now())
  currency     String? // null = the account's main currency
  sharedAt     DateTime? // when the link was made: waiting for the client's reply counts from here
  nudgedAt     DateTime? // last follow-up sent; waiting counts again from here

  @@index([userId, createdAt])
}

// A monthly retainer (e.g. social media for a café): each month it becomes a task with this amount.
model RecurringJob {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  client      String   @default("")
  amount      Float
  dayOfMonth  Int      @default(1) // due day; months shorter than this use their last day
  active      Boolean  @default(true)
  lastMonth   String? // "YYYY-MM" of the last task made, so a month is never made twice
  autoInvoice Boolean  @default(false) // give the month's job an invoice number and a client link right away
  clientEmail String   @default("") // the invoice link is emailed here when mail is set up
  lastInvoice String? // "YYYY-MM" of the last invoice emailed, so a month is never emailed twice
  createdAt   DateTime @default(now())

  @@index([userId])
}

// A file delivered on a task (stored in Vercel Blob). `round` = 1 for the first delivery, +1 after each revision.
model Delivery {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  url       String
  name      String
  type      String
  size      Int
  round     Int      @default(1)
  createdAt DateTime @default(now())

  @@index([taskId])
}

// A revision request on a task, from the client (review link) or logged by the owner.
model Revision {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  note      String   @default("")
  by        String   @default("owner") // owner | client
  createdAt DateTime @default(now())

  @@index([taskId])
}

// A step inside a task (sketch, colours, export…), ticked off as the work goes.
model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

// Contact details and notes for a client. Clients are still identified by the name used on tasks/money.
model ClientInfo {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String  @default("")
  email       String  @default("")
  notes       String  @default("")
  portalToken String? @unique // one link where the client sees all their quotes, invoices and deliveries

  @@unique([userId, name])
}

// Items recorded offline carry an id made on the phone; storing it makes a re-sent item a no-op.
model SyncedOp {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// A planned payment on a task (deposit, on delivery…). Marking one paid adds to Task.paid and records the income.
model Installment {
  id       String    @id @default(cuid())
  taskId   String
  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  label    String
  amount   Float
  due      DateTime?
  paidAt   DateTime?
  entryId  String? // the income row made when it was marked paid, removed again if that is undone
  position Int       @default(0)

  @@index([taskId])
  @@index([userId, paidAt])
}

// A kind of job done again and again (logo, social pack…): its price, steps and delivery time, to start a task from.
model TaskTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  amount    Float?
  days      Int? // delivery time: the new task is due this many days after it's made
  steps     String   @default("") // one step per line, becomes the task's checklist
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

// Someone who asked about work but hasn't agreed yet: followed from first message to won or lost.
model Lead {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  contact   String    @default("") // phone or email
  need      String    @default("") // what they asked for
  budget    Float?
  source    String    @default("") // Instagram, Behance, a friend…
  status    String    @default("new") // new | quoted | waiting | won | lost
  nextAt    DateTime? // when to follow up
  notes     String    @default("")
  taskId    String? // the task made when won
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, status])
}

// A simple work agreement for one task. The owner edits the text; the client accepts it from a link by typing
// their name. What they accepted is kept word for word (acceptedBody), so later edits can't change it.
model Contract {
  id           String    @id @default(cuid())
  taskId       String    @unique
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId       String
  body         String
  shareToken   String?   @unique
  sharedAt     DateTime? // when the link was made
  nudgedAt     DateTime? // last follow-up sent
  acceptedAt   DateTime?
  acceptedName String?
  acceptedBody String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A call or meeting at a set time. The meetings cron pushes a reminder about an hour before, once
// (remindedAt is claimed); changing the time clears it so the new time is reminded too.
// `at` is wall-clock time in the studio's timezone, like every other date here.
model Meeting {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  client     String    @default("")
  at         DateTime
  place      String    @default("") // a meeting link or an address
  notes      String    @default("")
  remindedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, at])
  @@index([at])
}

// Weekly automatic copies of a notebook (the same JSON as «نسخة احتياطية», gzipped). The last 4 are kept.
model AutoBackup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  size      Int // bytes of the JSON before compression
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// One invoice for several jobs of the same client. It takes a number from the same yearly counter as single
// invoices. Payments stay on each job; the invoice adds them up. Cancelling frees the jobs, and the number
// stays in the log as cancelled (numbers are never reused).
model ClientInvoice {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      String
  invoiceNo   String
  issuedAt    DateTime
  shareToken  String?   @unique
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  tasks       Task[]

  @@unique([userId, invoiceNo])
  @@index([userId, issuedAt])
}
