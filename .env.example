# PostgreSQL. On Vercel, connecting Supabase (Storage tab) sets both automatically.
# POSTGRES_PRISMA_URL = pooled URL (app), POSTGRES_URL_NON_POOLING = direct URL (migrations).
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/daftar"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/daftar"
# Signs login cookies. Required in production: 32+ random characters (openssl rand -base64 48).
SESSION_SECRET=
# Optional: lets «رتّبهالي» and the monthly report use Claude.
ANTHROPIC_API_KEY=
# Optional: defaults to Africa/Cairo. Decides what "today" is.
APP_TIMEZONE=
# Optional: emails that get the admin page (/app/admin), comma-separated.
ADMIN_EMAILS=
# Optional, free tier: Google Gemini for «رتّبهالي» and the report when ANTHROPIC_API_KEY is not set.
# Key from https://aistudio.google.com/apikey. GEMINI_MODEL defaults to gemini-flash-latest.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: Gmail (read-only) in «الرسايل». OAuth client from Google Cloud Console → APIs & Services → Credentials.
# Redirect URI to register: https://<your-domain>/api/gmail/callback (override with GOOGLE_REDIRECT_URI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
